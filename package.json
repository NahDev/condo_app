{
  "name": "condo-app",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:migrate": "pnpm --filter @condo/db exec prisma migrate dev",
    "db:deploy": "pnpm --filter @condo/db exec prisma migrate deploy",
    "db:seed": "pnpm --filter @condo/db exec prisma db seed",
    "db:studio": "pnpm --filter @condo/db exec prisma studio"
  },
  "devDependencies": {
    "turbo": "^2.1.3",
    "typescript": "^5.6.3"
  },
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20"
  }
}
